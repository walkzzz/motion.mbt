// Logic-side specifications for the safety state machine (spec 3.4, invariants I1/I2).
// Predicates here are proof-only: they are not executable MoonBit code.
// Enum comparisons go through the #proof_pure rank helpers in safety.mbt
// (Selftest=0 Idle=1 Executing=2 Recovering=3 SafeHold=4 FaultLocked=5).

// Full functional spec of next_state (the transition target function).
// I1: any SafetyEvent in Executing preempts to SafeHold; in other states it is a no-op.
predicate next_state_spec(from : SafetyState, event : StateEvent, result : SafetyState) {
  match event {
    Safety(_) =>
      (state_rank(from) == 2 && state_rank(result) == 4) ||
      (state_rank(from) != 2 && state_rank(result) == state_rank(from))
    Reset =>
      (state_rank(from) == 2 && state_rank(result) == 2) ||
      (state_rank(from) != 2 && state_rank(result) == 1)
    TaskStart =>
      (state_rank(from) == 1 && state_rank(result) == 2) ||
      (state_rank(from) != 1 && state_rank(result) == state_rank(from))
    TaskComplete =>
      ((state_rank(from) == 2 || state_rank(from) == 3) && state_rank(result) == 1) ||
      ((state_rank(from) != 2 && state_rank(from) != 3) &&
        state_rank(result) == state_rank(from))
  }
}

// I2: FAULT_LOCKED is left ONLY via Reset — every other event is rejected.
// For non-FaultLocked sources this predicate is vacuous (true).
predicate valid_transition_i2(from : SafetyState, event : StateEvent, result : Bool) {
  !(state_rank(from) == 5) || (result == is_reset_event(event))
}
